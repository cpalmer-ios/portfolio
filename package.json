{
  "name": "expandingroundedmenu",
  "version": "1.0.0",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "description": "",
  "scripts": {
    "start": "parcel ./index.html --open",
    "clean": "rm -rf docs/*",
    "copy-files": "mkdir -p docs && cp -r index.html hover.html css fonts js img favicon.ico docs/",
    "copy-node-modules": "mkdir -p docs/node_modules && cp -r node_modules/gsap docs/node_modules/",
    "build": "npm run clean && npm run copy-files && npm run copy-node-modules && touch docs/.nojekyll",
    "deploy": "git add docs && git commit -m 'Update GitHub Pages' && git push origin main"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cpalmer-ios/portfolio.git"
  },
  "keywords": [],
  "author": "Codrops",
  "license": "MIT",
  "homepage": "https://cpalmer-ios.github.io/portfolio",
  "bugs": {
    "url": "https://github.com/cpalmer-ios/portfolio/issues"
  },
  "dependencies": {
    "gsap": "^3.9.1",
    "parcel": "latest"
  }
}