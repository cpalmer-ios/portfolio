{
  "name": "portfolio",
  "version": "1.0.0",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "description": "Portfolio site with card expansion effect",
  "scripts": {
    "start": "parcel ./index.html --open",
    "clean": "rm -rf dist/*",
    "build:parcel": "parcel build ./index.html --no-content-hash --no-source-maps --public-url ./",
    "copy-assets": "node copy-assets.js",
    "post-process": "node post-process-html.js",
    "build": "npm run clean && npm run build:parcel && npm run copy-assets && cp CNAME .htaccess _redirects dist/ && npm run post-process",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/cpalmer-ios/portfolio.git"
  },
  "keywords": ["portfolio", "cards", "animation"],
  "author": "Chris Palmer",
  "license": "MIT",
  "homepage": "https://web-dek.uk",
  "bugs": {
    "url": "https://github.com/cpalmer-ios/portfolio/issues"
  },
  "dependencies": {
    "gsap": "^3.9.1",
    "parcel": "latest"
  },
  "devDependencies": {
    "gh-pages": "^6.1.0"
  }
}
